{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workshop",
  "version": "0.1.5",
  "identifier": "com.lindsaybrunner.workshop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Workshop",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../../../clients/demo-redline",
      "../../../clients/demo-megaphone",
      "../../../clients/fixture",
      "../../../clients/template-redline",
      "../../../clients/template-megaphone"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 640,
          "height": 400
        },
        "appPosition": {
          "x": 220,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 420,
          "y": 200
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBMjlENUYxREQxOUNENTQKUldSVXpSbmQ4ZFVwR3UvQ1ZDZGxabGhidnpnOFdNZ2p5NWR4S1MxR1U3UHhseG1PZGhLWGVjNGkK",
      "endpoints": [
        "https://workshop-updates-lindsaybrunner.netlify.app/latest.json"
      ]
    }
  }
}
